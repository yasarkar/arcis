# ==============================================================================
# Arcis Protocol Environment Variables Template
# Copy this file to .env and replace placeholder values with your own keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Network & Environment Configuration
# ------------------------------------------------------------------------------
# Choose target network: 'testnet' (Arc Testnet 5042002) or 'mainnet' (Arc Mainnet)
VITE_APP_ENV=testnet

# Custom Arc RPC endpoint (Optional override; defaults to official Arc RPC with fallbacks)
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io

# ------------------------------------------------------------------------------
# 1. Circle Developer Console Credentials (Backend & WebSDK)
# ------------------------------------------------------------------------------
# Obtain from: https://console.circle.com -> Project Settings -> API Keys
CIRCLE_API_KEY=YOUR_CIRCLE_API_KEY_HERE

# Obtain from: Circle Developer Console -> Project Settings -> Client Keys
VITE_CLIENT_KEY=YOUR_CIRCLE_CLIENT_KEY_HERE
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Obtain from: Circle Developer Console -> Project Settings -> Kit Keys
KIT_KEY=YOUR_KIT_KEY_HERE

# Obtain from: Circle Developer Console -> Wallets -> User-Controlled -> Configurator
VITE_CIRCLE_APP_ID=YOUR_CIRCLE_APP_ID_HERE

# ------------------------------------------------------------------------------
# 2. AI Copilot (OpenAI / OpenRouter) - Server-Side Only
# ------------------------------------------------------------------------------
# Server-side key for Arco Natural Language Copilot (Optional: Local NLP fallback is active if empty)
OPENAI_API_KEY=your_openai_api_key_or_openrouter_key

# ------------------------------------------------------------------------------
# 3. Web3 & Social Login Provider Credentials (Optional)
# ------------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=
VITE_APPLE_CLIENT_ID=
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_from_cloud_walletconnect_com

# ------------------------------------------------------------------------------
# 4. Protocol Fee Configuration (Arcis Platform Fee)
# ------------------------------------------------------------------------------
# Custom Swap Fee (1 BPS = 0.01%)
VITE_SWAP_FEE_ENABLED=true
VITE_SWAP_FEE_BPS=10
VITE_SWAP_FEE_RECIPIENT=

# Custom Bridge Fee (fixed USDC amount)
VITE_BRIDGE_FEE_ENABLED=true
VITE_BRIDGE_FEE_VALUE=0.10
VITE_BRIDGE_FEE_RECIPIENT=

# Arcis Protocol Treasury Addresses (Multi-Chain Support)
# EVM Treasury Address (Default for Arc, Ethereum, Base, Arbitrum, Optimism, Polygon, Avalanche)
VITE_TREASURY_ADDRESS=
# Solana Treasury Address (Required for custom fees when bridging/swapping from Solana)
VITE_SOLANA_TREASURY_ADDRESS=
# Injective Treasury Address 
VITE_INJECTIVE_TREASURY_ADDRESS=

# ------------------------------------------------------------------------------
# 5. Meta-Transaction Relayer (Gasless Sponsor for Arc Testnet / Mainnet)
# ------------------------------------------------------------------------------
# Dedicated Relayer account private key (Must be kept private on backend server)
PRIVATE_KEY=0x_your_secure_relayer_private_key_here

# ------------------------------------------------------------------------------
# 6. Vercel KV / Upstash Redis Storage (History, Cache & Rate Limiter)
# ------------------------------------------------------------------------------
KV_REST_API_READ_ONLY_TOKEN=ggAAAAAAAoCi...
KV_REST_API_TOKEN=gQAAAAAAAoCi...
KV_REST_API_URL=https://your-upstash-db.upstash.io
KV_URL=rediss://default:token@your-upstash-db.upstash.io:6379
REDIS_URL=rediss://default:token@your-upstash-db.upstash.io:6379

