# ==============================================================================
# Arcis Protocol Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Network & Environment Configuration
# ------------------------------------------------------------------------------
# Choose target network: 'testnet' (Arc Testnet 5042002) or 'mainnet' (Arc Mainnet)
# VITE_NETWORK and APP_ENV are accepted as legacy aliases (same values).
VITE_APP_ENV=testnet
# Custom Arc RPC endpoint (Optional override; defaults to official Arc RPC with fallbacks)
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
# API server port for `npm start` / `npm run dev` (default 3000).
PORT=3000
# Comma-separated origins allowed to call the API cross-origin (e.g. https://app.example.com).
# Empty means same-origin only. Credentialed CORS is never enabled.
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# 1. Circle Developer Console Credentials (Backend & WebSDK)
# ------------------------------------------------------------------------------
# Obtain from: https://console.circle.com -> Project Settings -> API Keys
CIRCLE_API_KEY=YOUR_CIRCLE_API_KEY_HERE
# ------------------------------------------------------------------------------
# 1b. UCW Session Cookie Signing Secret (Recommended in production)
# ------------------------------------------------------------------------------
# Signs the httpOnly cookie that holds the Circle UCW userToken, so the wallet's
# signing authority never sits in browser storage. Generate any long random
# string (e.g. `openssl rand -hex 32`). When unset, the server falls back to
# CIRCLE_API_KEY; when neither exists it refuses to issue a wallet session at all.
UCW_SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET_HERE

# Obtain from: Circle Developer Console -> Project Settings -> Client Keys
VITE_CLIENT_KEY=YOUR_CIRCLE_CLIENT_KEY_HERE
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Obtain from: Circle Developer Console -> Project Settings -> Kit Keys
# Reserved: the current bridge/swap path (App Kit bridge, CCTP-X, Swap Kit) is invoked from scripts
# and does not read this value yet. Kept so enabling a kit-keyed swap needs no new variable.
KIT_KEY=YOUR_KIT_KEY_HERE

# Obtain from: Circle Developer Console -> Wallets -> User-Controlled -> Configurator
VITE_CIRCLE_APP_ID=YOUR_CIRCLE_APP_ID_HERE

# ------------------------------------------------------------------------------
# 2. AI Copilot (OpenRouter) - Server-Side Only
# ------------------------------------------------------------------------------
# Server-side key for Arco Natural Language Copilot (Optional: Local NLP fallback is active if empty).
# Also required by the paid `llm` x402 service (arc-vault-yield-tax-report);
# without it that call returns UNAVAILABLE. Never expose this as VITE_*.
OPENROUTER_API_KEY=your_openrouter_key
# The model must support `response_format: {"type":"json_object"}`. Reasoning models are allowed:
# they spend part of the output budget on hidden reasoning before writing the answer, which is why
# the budget below is generous and one retry is made on `finish_reason: "length"`.
OPENROUTER_MODEL=your_preffered_model
# Completion budget per paid `llm` call (100-8000, default 1600). Too small for a reasoning model
# means an empty message and a voided (uncharged) call.
X402_LLM_MAX_OUTPUT_TOKENS=1600

# ------------------------------------------------------------------------------
# 3. Web3 & Social Login Provider Credentials (Optional)
# ------------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=
VITE_APPLE_CLIENT_ID=
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_from_cloud_walletconnect_com

# ------------------------------------------------------------------------------
# 4. Protocol Fee Configuration (Arcis Platform Fee)
# ------------------------------------------------------------------------------
# Custom Swap Fee (1 BPS = 0.01%)
VITE_SWAP_FEE_ENABLED=true
VITE_SWAP_FEE_BPS=100
VITE_SWAP_FEE_RECIPIENT=

# Custom Bridge Fee (Dynamic volume percentage with minimum floor and maximum ceiling)
VITE_BRIDGE_FEE_ENABLED=true
VITE_BRIDGE_FEE_BPS=5
VITE_BRIDGE_FEE_MIN_USDC=0.10
VITE_BRIDGE_FEE_MAX_USDC=1.00
VITE_BRIDGE_FEE_RECIPIENT=

# Arcis Protocol Treasury Addresses (Multi-Chain Support)
# EVM Treasury Address (Default for Arc, Ethereum, Base, Arbitrum, Optimism, Polygon, Avalanche)
VITE_EVM_TREASURY_ADDRESS=
# Solana Treasury Address (Required for custom fees when bridging/swapping from Solana)
VITE_SOLANA_TREASURY_ADDRESS=
# Injective Treasury Address 
VITE_INJECTIVE_TREASURY_ADDRESS=

# ------------------------------------------------------------------------------
# 5. Server Signer Keys — Gasless Relayer & Vault Distributor (Keep private)
# ------------------------------------------------------------------------------
# Dedicated relayer key: gasless sponsorship + server-side signing. Never your deployer key.
RELAYER_PRIVATE_KEY=
# Optional dedicated key for the USDC yield-vault keeper; falls back to RELAYER_PRIVATE_KEY.
DISTRIBUTOR_KEY=
# NOTE: PRIVATE_KEY is the Foundry deploy key for contracts/.env. The server never reads it
# (see api/_utils/serverSigner.ts) — a deploy key must not sign relayer or vault operations.

# ------------------------------------------------------------------------------
# 6. Vercel KV / Upstash Redis Storage (History, Cache & Rate Limiter)
# ------------------------------------------------------------------------------
KV_REST_API_READ_ONLY_TOKEN=ggAAAAAAAoCi...
KV_REST_API_TOKEN=gQAAAAAAAoCi...
KV_REST_API_URL=https://your-upstash-db.upstash.io
KV_URL=rediss://default:token@your-upstash-db.upstash.io:6379
REDIS_URL=rediss://default:token@your-upstash-db.upstash.io:6379

# ------------------------------------------------------------------------------
# 7. x402 Circle Gateway — Arc Testnet
# ------------------------------------------------------------------------------
# Settlement is OFF by default. Enabling it makes real testnet USDC move.
# Before ENABLE_GATEWAY_SETTLE=true:
#   1) npm run audit:x402-payouts      (every manifest provider address must be a wallet you control)
#   2) configure shared storage        (KV_REST_API_* below, or REDIS_URL/KV_URL)
#   3) set the reconciliation secret and confirm the payout addresses
#   4) configure the protocol treasury below (official services charge a fee)
#   5) npm run preflight:x402 -- --live
ENABLE_GATEWAY_SETTLE=false
# Official services charge 50 bps (OFFICIAL_PROTOCOL_FEE_BPS). A paid call's EIP-3009
# authorization names one payee, so a fee-bearing call settles to this treasury and providers
# withdraw their net earnings from it. Empty falls back to VITE_EVM_TREASURY_ADDRESS; without
# either address, fee-bearing settlement fails closed (503).
X402_TREASURY_ADDRESS=
# Key for the treasury wallet: signs the ERC-20 USDC payouts providers withdraw. It must derive to
# X402_TREASURY_ADDRESS; a mismatch is refused, and an empty key answers 503 rather than collecting
# fees it could not pay out. Server-side only — never expose it as VITE_*.
X402_TREASURY_PRIVATE_KEY=
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# Set to true only after auditing and confirming ownership of every manifest provider address.
X402_PAYOUT_ADDRESSES_CONFIRMED=false
# Required for the reconcile endpoint and the background settlement reconciler; never expose to VITE_*.
X402_RECONCILIATION_SECRET=YOUR_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
# Background reconciler (standalone server): every 5 minutes, up to 50 pending records per sweep.
# Keep it running even when new settlement is turned off: already-accepted payments still need closing.
X402_RECONCILE_ENABLED=true
X402_RECONCILE_INTERVAL_MINUTES=5
X402_RECONCILE_BATCH_SIZE=50
# Optional comma-separated HTTPS upstream hostnames for community x402 proxy services.
# Host only (no scheme, path or port). A host that is not listed makes community registration
# fail with 400 "Invalid or unsafe community manifest" and paid calls fail with 503.
# The smoke-test echo upstream lives in smoke/ucw-echo (see its README to deploy it).
X402_UPSTREAM_HOST_ALLOWLIST=
# Optional default echo endpoint for `npm run preflight:ucw-smoke -- --live` (docs/ucw-x402-smoke-test-plan.md).
UCW_SMOKE_ENDPOINT=

# ------------------------------------------------------------------------------
# 8. Pools V4 — on-chain per-user fee accounting + real harvest
# ------------------------------------------------------------------------------
#   forge script script/DeployVaultV4.s.sol --rpc-url arc_testnet --broadcast
# USDC address the vault keeper and /api/vault read balances for (defaults to Arc Testnet USDC).
VITE_POOL_USDC=0x3600000000000000000000000000000000000000
VITE_POOL_VERSION=v4
VITE_POOL_V4_STABLE_SWAP=0x405Ad05AD4E2a619bB9F25A22E0D858654eDaD96
VITE_POOL_V4_CONSTANT_PRODUCT=0x1615D0B7300FDCFB43C6bC2f0ea51Ea64f9833dB
VITE_POOL_V4_YIELD_VAULT=0xb2a6D2BF896b431a77FB9198519fE334Caf39e9A
VITE_POOL_V4_WETH_POOL=0x4fB42dBbA5AD26723106bd56cA647dEb4a75Cd90
VITE_POOL_V4_EURC_WETH_POOL=0x94f1fB8ab07146BB2C1f2A9AF155d51413a45809
VITE_POOL_V4_EURC_CIRBTC_POOL=0x0000000000000000000000000000000000000000
VITE_POOL_V4_CIRBTC_WETH_POOL=0x0000000000000000000000000000000000000000
VITE_POOL_V4_ROUTER=0x22733d5C4C91C7BEF2BED43e3f3F42B2d91DfcD4
# ------------------------------------------------------------------------------
# 9. Automated Yield Vault Keeper Service (Arc Testnet)
# ------------------------------------------------------------------------------
# Automatically checks accumulated platform fees and distributes USDC yield to vault holders
VAULT_KEEPER_ENABLED=true
VAULT_KEEPER_INTERVAL_MINUTES=60
VAULT_KEEPER_AMOUNT_USDC=5
# ------------------------------------------------------------------------------
# 10. Client IP trust for IP-scoped rate limits (faucet, copilot, UCW OTP)
# ------------------------------------------------------------------------------
# Forwarding headers are read only behind an edge that overwrites x-forwarded-for. Vercel is
# detected automatically; set this to true only if your own proxy rewrites the header.
TRUST_PROXY_HEADERS=false
# How many trailing x-forwarded-for entries that edge appended (default 1).
TRUSTED_PROXY_HOPS=1
